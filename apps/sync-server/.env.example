PORT=7777

# Nombre de esta experiencia tal como debe aparecer como "source" en Evius.
EXPERIENCE_NAME="Mirage - Catalogo de Productos"

# Evius (eviusapi/Datahub). "Mirage Colombia" y "Mirage Mexico" son eventos
# separados en Evius, por lo tanto estas variables son distintas por pais -
# nunca se comparten entre despliegues. Sin configurar, el outbox acumula y
# reintenta indefinidamente, igual que si no hubiera internet.
EVIUS_URL=
EVIUS_TOKEN=
EVIUS_EVENT_ID=
EVIUS_EXPERIENCE_ID=

# ISO 3166-1 alpha-2 ('CO' | 'MX') - misma convencion usada por el proyecto
# de Memory Match y por la columna `country` en Supabase. No mezclar con
# nombres completos ('Colombia'/'Mexico') en ningun despliegue.
COUNTRY=

# DB propia para rankings: proyecto Supabase (ver docs/supabase-schema.sql).
# RANKING_DB_URL es la URL base del proyecto (https://xxxx.supabase.co, SIN
# /rest/v1 ni tabla). RANKING_DB_API_KEY es la service_role key (la tabla
# no tiene policy de insert para anon/authenticated a proposito). Un solo
# proyecto compartido entre paises y entre experiencias (catalogo, memory
# match) via las columnas country/experience de cada registro.
RANKING_DB_URL=
RANKING_DB_API_KEY=
RANKING_DB_TABLE=participations
